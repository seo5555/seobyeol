      "source": [
        "df['cust_merch_distance_km'] = haversine(\n",
        "    df['cust_lat'].to_numpy(), df['cust_long'].to_numpy(),\n",
        "    df['merch_lat'].to_numpy(), df['merch_long'].to_numpy()\n",
        ")"
      ],
