    {
      "cell_type": "code",
      "source": [
        "# 시간 컬럼 파싱\n",
        "df['t_datetime'] = pd.to_datetime(df['t_datetime'], errors='coerce')\n",
        "df['cust_dob'] = pd.to_datetime(df['cust_dob'], errors='coerce')\n",
        "\n",
        "# 시간 파생\n",
        "df['t_hour'] = df['t_datetime'].dt.hour\n",
        "df['t_dayofweek'] = df['t_datetime'].dt.dayofweek  # 0=월, 6=일\n",
        "df['t_is_weekend'] = df['t_dayofweek'].isin([5, 6]).astype(int)\n",
        "\n",
        "# 나이 계산 (생일이 아직 지나지 않았으면 -1)\n",
        "t = df['t_datetime']; b = df['cust_dob']\n",
        "df['cust_age'] = (\n",
        "    t.dt.year - b.dt.year\n",
        "    - (\n",
        "        (t.dt.month < b.dt.month) |\n",
        "        ((t.dt.month == b.dt.month) & (t.dt.day < b.dt.day))\n",
        "    ).astype(int)\n",
        ")"
      ],
