CREATE OR REPLACE TABLE `my-project-55758-470803.A004.A004_cleaned` AS
WITH temp AS (
 SELECT
  product_id,
  product_name,
  category,
  discounted_price,
  actual_price,
  SAFE_CAST(discount_percentage AS FLOAT64) AS discount_percentage,
  SAFE_CAST(rating AS FLOAT64) AS rating,
  rating_count,
  about_product,
  img_link,
  product_link
 FROM `my-project-55758-470803.A004.A004`
)
SELECT *
FROM temp
WHERE discount_percentage IS NOT NULL;

-- -- 착한 가격 추천: 할인율 상위 상품 추출
SELECT 
 product_id,
 product_name,
 discounted_price,
 actual_price,
 discount_percentage,
 rating,
 rating_count
FROM `my-project-55758-470803.A004.A004_cleaned`
ORDER BY discount_percentage DESC
LIMIT 20;

