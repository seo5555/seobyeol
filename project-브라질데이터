-- -- 신뢰성 추천: 평점 4.0 이상 + 리뷰 수 많은 상품
SELECT 
 product_id,
 product_name,
 rating,
 rating_count,
 discounted_price,
 actual_price,
 discount_percentage
FROM `my-project-55758-470803.A004.A004_cleaned`
WHERE rating >= 4.0
 AND rating_count IS NOT NULL
ORDER BY rating_count DESC
LIMIT 20;
-------------------------------------------------------------

-- -- 가성비 추천: 평점, 리뷰 수, 가격을 종합한 Value Score
SELECT 
 product_id,
 product_name,
 rating,
 rating_count,
 discounted_price,
 actual_price,
 discount_percentage,
  ROUND((rating * LOG(rating_count + 1)) / discounted_price, 4) AS value_score
FROM `my-project-55758-470803.A004.A004_cleaned`
WHERE rating IS NOT NULL
 AND rating_count IS NOT NULL
 AND discounted_price > 0
ORDER BY value_score DESC
LIMIT 20;

--------------------------------------------------------------

-- -- 트렌드 추천: 리뷰 수 × 평점 × 할인율 기반
SELECT 
 product_id,
 product_name,
 rating,
 rating_count,
 discounted_price,
 actual_price,
 discount_percentage,
 ROUND(rating * LOG(rating_count + 1) * (1 + discount_percentage), 2) AS trend_score
FROM `my-project-55758-470803.A004.A004_cleaned`
WHERE rating >= 4.0
 AND rating_count IS NOT NULL
 AND discount_percentage IS NOT NULL
ORDER BY trend_score DESC
LIMIT 20;

